# ---- Core ----
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-32+-random-chars
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=./.data/app.db

# ---- Cloudinary (MANDATORY in production) ----
# Either the single URL ...
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ... or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=credit-ladder
# Local disk stand-in for offline dev/tests ONLY. Refused when NODE_ENV=production.
CLOUDINARY_MOCK=0
# Voice answers are deleted right after transcription; this is the safety-net age (minutes)
VOICE_MAX_AGE_MIN=60

# ---- Speech providers: mock | sarvam ----
TTS_PROVIDER=mock
STT_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_STT_MODEL=saaras:v3
